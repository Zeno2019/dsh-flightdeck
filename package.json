{
  "name": "dsh-flightdeck",
  "productName": "DSH Flightdeck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:target:win": "node scripts/verify-target.mjs win32 x64",
    "package:dir": "npm run verify:target:win && npm run build && electron-builder --dir --win --x64 --publish never",
    "package:win": "npm run verify:target:win && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "node": "24.19.0",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.zeno.dsh-flightdeck",
    "productName": "DSH Flightdeck",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/runtime-node-entry.mjs",
        "to": "runtime-node-entry.mjs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "dsh-flightdeck-windows-${arch}-setup.${ext}"
    }
  }
}
